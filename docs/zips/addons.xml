<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.papa" name="Repo Kodi de Papá" version="1.0.0" provider-name="Bruivert">
    <extension point="xbmc.addon.repository" name="Repo Kodi de Papá">
        <dir>
            <info compressed="false">https://bruivert.github.io/Kodi/zips/addons.xml</info>
            <checksum>https://bruivert.github.io/Kodi/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://bruivert.github.io/Kodi/zips/</datadir>
        </dir>
        <dir minversion="20.9.1">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/</datadir>
        </dir>
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">Repositorio del Kodi de Papá (incluye las skins de jurialmunkey para Omega).</summary>
        <summary lang="en_GB">Kodi de Papá repository (includes jurialmunkey's Omega skins).</summary>
        <description lang="es_ES">Instala desde aquí «Kodi de Papá — Asistente». Las actualizaciones llegan solas.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="script.papa.inicio" name="Kodi de Papá — Asistente" version="1.0.1" provider-name="Bruivert">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.requests" version="2.22.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">Monta el Kodi de tu padre: estilo Apple TV con Palantir y BlackGhost.</summary>
        <summary lang="en_GB">Sets up an Apple TV style Kodi home with Palantir and BlackGhost.</summary>
        <description lang="es_ES">Instala Arctic Fuse 3 y crea el menú Películas, Series, Novedades, Deportes y Favoritos a partir de Palantir y BlackGhost. Añade la nota de IMDb y tráileres automáticos en español de España.</description>
        <description lang="en_GB">Installs Arctic Fuse 3 and builds a Movies, TV, New, Sports and Favourites menu from Palantir and BlackGhost, with IMDb ratings and Spain-Spanish auto trailers.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/Bruivert/Kodi</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
